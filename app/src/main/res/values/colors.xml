    <!-- Status colors used across HRMS modules (attendance, leave, payroll) -->
    <color name="hrms_status_success">#1E8E3E</color>
    <color name="hrms_status_success_container">#D6F3DD</color>
    <color name="hrms_status_warning">#B26A00</color>
    <color name="hrms_status_warning_container">#FFE7C2</color>
    <color name="hrms_status_info">@color/hrms_blue_40</color>
    <color name="hrms_status_info_container">@color/hrms_blue_90</color>

    <!-- Additional attendance status colors (Phase 3): Present/Late/Work From Home reuse
         success/warning/info above; Absent reuses the error palette. Half Day and Leave get
         their own tones since neither maps cleanly onto an existing role. -->
    <color name="hrms_status_absent">@color/hrms_red_40</color>
    <color name="hrms_status_absent_container">@color/hrms_red_90</color>
    <color name="hrms_status_half_day">#00696D</color>
    <color name="hrms_status_half_day_container">#9DF1F5</color>
    <color name="hrms_status_leave">#6750A4</color>
    <color name="hrms_status_leave_container">#EADDFF</color>

    <color name="hrms_scrim">#66000000</color>
    <color name="transparent">#00000000</color>
</resources>
