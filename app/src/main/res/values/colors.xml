    <color name="hrms_neutral_variant_80">#C4C6D0</color>
    <color name="hrms_neutral_variant_90">#E1E2EC</color>

    <!-- Semantic role tokens : Light -->
    <color name="md_theme_light_primary">@color/hrms_blue_40</color>
    <color name="md_theme_light_onPrimary">@color/hrms_blue_100</color>
    <color name="md_theme_light_primaryContainer">@color/hrms_blue_90</color>
    <color name="md_theme_light_onPrimaryContainer">@color/hrms_blue_10</color>

    <color name="md_theme_light_secondary">@color/hrms_teal_40</color>
