    <!--
        HRMS Design System — Color Tokens (Light)
        Material 3 color roles, hand-tuned around a professional blue/teal brand pair.
        Mirrored for dark mode in values-night/colors.xml (same token names).
    -->

    <!-- Brand seed swatches (raw palette, referenced by role tokens below; avoid using
         these directly in layouts — prefer the semantic ?attr/color* roles from themes.xml) -->
    <color name="hrms_blue_10">#00174A</color>
    <color name="hrms_blue_20">#002B77</color>
    <color name="hrms_blue_40">#1957C2</color>
    <color name="hrms_blue_80">#AEC6FF</color>
    <color name="hrms_blue_90">#D7E2FF</color>
    <color name="hrms_blue_100">#FFFFFF</color>

    <color name="hrms_teal_20">#00382D</color>
    <color name="hrms_teal_40">#2E7D6B</color>
    <color name="hrms_teal_80">#96D4C1</color>
    <color name="hrms_teal_90">#B5F1DE</color>

    <color name="hrms_amber_20">#412D00</color>
    <color name="hrms_amber_40">#7C5800</color>
    <color name="hrms_amber_80">#F4BE48</color>
    <color name="hrms_amber_90">#FFDEA6</color>

    <color name="hrms_red_40">#BA1A1A</color>
