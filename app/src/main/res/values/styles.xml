<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        HRMS Design System — Component styles
        Buttons, Cards, Text fields, Dialogs, Toolbar, Progress indicators.
        Screens should reference these Widget.HRMS.* styles (or rely on the
        theme defaults wired in themes.xml) instead of styling views ad-hoc.
    -->

    <!-- ===================== Buttons ===================== -->

    <style name="Widget.HRMS.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.HRMS.LabelLarge</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.HRMS.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.HRMS.LabelLarge</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">@dimen/stroke_width_thin</item>
    </style>

    <style name="Widget.HRMS.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.HRMS.LabelLarge</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.HRMS.Button.Destructive" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.HRMS.LabelLarge</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">?attr/colorError</item>
        <item name="android:textColor">?attr/colorOnError</item>
    </style>

    <style name="Widget.HRMS.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===================== Cards ===================== -->

    <style name="Widget.HRMS.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="contentPadding">@dimen/space_lg</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.HRMS.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="contentPadding">@dimen/space_lg</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/stroke_width_thin</item>
    </style>

    <style name="Widget.HRMS.Card.Interactive" parent="Widget.HRMS.Card">
        <item name="rippleColor">?attr/colorPrimary</item>
        <item name="checkedIconTint">?attr/colorPrimary</item>
    </style>

    <!-- ===================== Text fields ===================== -->

    <style name="Widget.HRMS.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_sm</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="errorTextColor">?attr/colorError</item>
        <item name="boxStrokeErrorColor">?attr/colorError</item>
    </style>

    <style name="Widget.HRMS.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.HRMS.BodyLarge</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
    </style>

    <!-- ===================== Dialogs ===================== -->

    <style name="ThemeOverlay.HRMS.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.HRMS.Large</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.HRMS.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.HRMS.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.HRMS.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.HRMS.Button.Text</item>
    </style>

    <style name="Widget.HRMS.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.HRMS.TitleLarge</item>
    </style>

    <style name="Widget.HRMS.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.HRMS.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===================== Loading / progress ===================== -->

    <style name="Widget.HRMS.ProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceContainerHigh</item>
        <item name="trackThickness">4dp</item>
    </style>

    <!-- ===================== Navigation chrome ===================== -->

    <style name="Widget.HRMS.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.HRMS.TitleLarge</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="Widget.HRMS.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/TextAppearance.HRMS.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.HRMS.LabelMedium</item>
        <item name="itemIconTint">@color/bottom_nav_item_tint</item>
        <item name="itemTextColor">@color/bottom_nav_item_tint</item>
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="elevation">@dimen/elevation_medium</item>
    </style>

    <!-- ===================== Text roles ===================== -->

    <style name="Widget.HRMS.Text.SectionHeader" parent="">
        <item name="android:textAppearance">@style/TextAppearance.HRMS.TitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.HRMS.Text.Caption" parent="">
        <item name="android:textAppearance">@style/TextAppearance.HRMS.BodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===================== Chips / status badges ===================== -->

    <style name="Widget.HRMS.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.HRMS.LabelMedium</item>
        <item name="chipMinHeight">28dp</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>
</resources>
