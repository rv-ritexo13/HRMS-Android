<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dark overrides. Same style name as values/themes.xml — the system resolves
         whichever one matches the active night-mode qualifier. Component-style and
         typography items are inherited unchanged from the light theme. -->
    <style name="Theme.HRMS" parent="Theme.Material3.Dark.NoActionBar">

        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>

        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>

        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>

        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>

        <item name="colorSurfaceContainerLowest">@color/md_theme_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_dark_surfaceContainerHighest</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.HRMS.DisplayLarge</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.HRMS.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.HRMS.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.HRMS.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.HRMS.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.HRMS.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.HRMS.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.HRMS.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.HRMS.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.HRMS.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.HRMS.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.HRMS.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.HRMS.LabelSmall</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.HRMS.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.HRMS.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.HRMS.Large</item>

        <item name="materialButtonStyle">@style/Widget.HRMS.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.HRMS.Card</item>
        <item name="textInputStyle">@style/Widget.HRMS.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.HRMS.BottomNavigation</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.HRMS.Dialog</item>
        <item name="toolbarStyle">@style/Widget.HRMS.Toolbar</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.HRMS.ProgressIndicator</item>
    </style>
</resources>
