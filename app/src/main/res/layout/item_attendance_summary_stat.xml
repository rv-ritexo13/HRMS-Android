<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.HRMS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/dotSummaryStat"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_status_dot" />

        <TextView
            android:id="@+id/textSummaryStatValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.HRMS.HeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="18" />

        <TextView
            android:id="@+id/textSummaryStatLabel"
            style="@style/Widget.HRMS.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            tools:text="Present" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
