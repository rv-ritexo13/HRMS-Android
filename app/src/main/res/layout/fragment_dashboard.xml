<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xxl">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_md">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/avatar_size_md"
                android:layout_height="@dimen/avatar_size_md"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="@dimen/radius_full"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/textAvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/dashboard_cd_avatar"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.HRMS.LabelLarge"
                    android:textColor="?attr/colorOnPrimary"
                    tools:text="RV" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Rahul Verma" />

                <TextView
                    android:id="@+id/textUserRole"
                    style="@style/Widget.HRMS.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Software Engineer · Engineering" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonNotifications"
                    style="@style/Widget.HRMS.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/dashboard_cd_notifications"
                    app:icon="@drawable/ic_notifications"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <View
                    android:id="@+id/dotNotificationBadge"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/shape_unread_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textTodayDate"
            style="@style/Widget.HRMS.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:paddingHorizontal="@dimen/space_lg"
            tools:text="Saturday, 19 September 2026" />

        <!-- Attendance card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HRMS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_attendance_title"
                        android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAttendanceStatus"
                        style="@style/Widget.HRMS.Chip.Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        tools:text="Not Checked In" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.HRMS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_attendance_check_in_label" />

                        <TextView
                            android:id="@+id/textCheckInTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/dashboard_attendance_time_placeholder"
                            android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.HRMS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_attendance_check_out_label" />

                        <TextView
                            android:id="@+id/textCheckOutTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/dashboard_attendance_time_placeholder"
                            android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.HRMS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_attendance_hours_label" />

                        <TextView
                            android:id="@+id/textWorkingHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/dashboard_attendance_hours_placeholder"
                            android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCheckIn"
                        style="@style/Widget.HRMS.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/dashboard_button_check_in" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCheckOut"
                        style="@style/Widget.HRMS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/dashboard_button_check_out" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mini info cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardLeaveBalance"
                    layout="@layout/item_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardSalary"
                    layout="@layout/item_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardPendingTasks"
                    layout="@layout/item_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/cardUpcomingMeeting"
                    layout="@layout/item_stat_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Recent announcements -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <include
                android:id="@+id/sectionAnnouncements"
                layout="@layout/layout_dashboard_section" />
        </LinearLayout>

        <!-- Upcoming holidays -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <include
                android:id="@+id/sectionHolidays"
                layout="@layout/layout_dashboard_section" />
        </LinearLayout>

        <!-- Recent notifications -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <include
                android:id="@+id/sectionNotifications"
                layout="@layout/layout_dashboard_section" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
