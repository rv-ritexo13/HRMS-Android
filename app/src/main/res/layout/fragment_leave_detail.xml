<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.HRMS.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/leave_detail_cd_back"
        app:title="@string/leave_detail_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header: type + status -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HRMS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageTypeIcon"
                            android:layout_width="@dimen/icon_size_lg"
                            android:layout_height="@dimen/icon_size_lg"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_calendar"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/textType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.HRMS.TitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Casual Leave" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStatus"
                            style="@style/Widget.HRMS.Chip.Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            tools:text="Pending" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Details -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HRMS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include android:id="@+id/dStart" layout="@layout/item_profile_field"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <include android:id="@+id/dEnd" layout="@layout/item_profile_field"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <include android:id="@+id/dDays" layout="@layout/item_profile_field"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <include android:id="@+id/dApplied" layout="@layout/item_profile_field"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <include android:id="@+id/dReason" layout="@layout/item_profile_field"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <include android:id="@+id/dAttachment" layout="@layout/item_profile_field"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Manager comments -->
                <TextView
                    style="@style/Widget.HRMS.Text.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/leave_detail_manager_comments" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HRMS.Card.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/textManagerComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.HRMS.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Approved. Enjoy your time off!" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancelRequest"
                    style="@style/Widget.HRMS.Button.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/leave_detail_cancel"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.triotech.hrms.ui.components.LoadingView
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.triotech.hrms.ui.components.ErrorView
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
