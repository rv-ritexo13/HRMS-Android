<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_lg"
        android:text="@string/salary_title"
        android:textAppearance="@style/TextAppearance.HRMS.HeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ===== Selected month summary ===== -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.HRMS.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textSelectedMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.HRMS.TitleLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="September 2026" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_lg"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/Widget.HRMS.Text.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/salary_summary_gross" />

                                <TextView
                                    android:id="@+id/textGrossValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.HRMS.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="₹85,000" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/Widget.HRMS.Text.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/salary_summary_deductions" />

                                <TextView
                                    android:id="@+id/textDeductionsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.HRMS.BodyLarge"
                                    android:textColor="@color/hrms_status_absent"
                                    tools:text="- ₹6,000" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/stroke_width_thin"
                                android:layout_marginVertical="@dimen/space_md"
                                android:background="?attr/colorOutline" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/salary_summary_net"
                                    android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/textNetValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.HRMS.HeadlineMedium"
                                    android:textColor="?attr/colorPrimary"
                                    tools:text="₹79,000" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_lg"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/imageCreditStatus"
                                    android:layout_width="@dimen/icon_size_sm"
                                    android:layout_height="@dimen/icon_size_sm"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_event_available"
                                    app:tint="@color/hrms_status_success" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_sm"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/textCreditStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.HRMS.LabelMedium"
                                        android:textColor="@color/hrms_status_success"
                                        tools:text="Salary Credited" />

                                    <TextView
                                        android:id="@+id/textCreditDate"
                                        style="@style/Widget.HRMS.Text.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        tools:text="30 September 2026" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonViewPayslip"
                                style="@style/Widget.HRMS.Button.Primary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_lg"
                                android:text="@string/salary_view_payslip"
                                app:icon="@drawable/ic_picture_as_pdf" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Earnings breakdown ===== -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.HRMS.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.HRMS.Text.SectionHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/salary_earnings" />

                            <include
                                android:id="@+id/rowBasic"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_md" />

                            <include
                                android:id="@+id/rowHra"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm" />

                            <include
                                android:id="@+id/rowSpecial"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm" />

                            <include
                                android:id="@+id/rowOtherAllowances"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/stroke_width_thin"
                                android:layout_marginVertical="@dimen/space_md"
                                android:background="?attr/colorOutline" />

                            <include
                                android:id="@+id/rowGrossTotal"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Deductions breakdown ===== -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.HRMS.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.HRMS.Text.SectionHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/salary_deductions" />

                            <include
                                android:id="@+id/rowPf"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_md" />

                            <include
                                android:id="@+id/rowPtax"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm" />

                            <include
                                android:id="@+id/rowOtherDeductions"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/stroke_width_thin"
                                android:layout_marginVertical="@dimen/space_md"
                                android:background="?attr/colorOutline" />

                            <include
                                android:id="@+id/rowDeductionsTotal"
                                layout="@layout/item_salary_component"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Salary history ===== -->
                    <TextView
                        style="@style/Widget.HRMS.Text.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/salary_history_title" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerSalaryHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:listitem="@layout/item_salary_history" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.triotech.hrms.ui.components.LoadingView
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.triotech.hrms.ui.components.ErrorView
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.triotech.hrms.ui.components.EmptyStateView
            android:id="@+id/emptyStateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
