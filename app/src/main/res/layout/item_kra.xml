<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.HRMS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textKraTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.HRMS.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Delivery &amp; Quality" />

            <TextView
                android:id="@+id/textKraWeightage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.HRMS.LabelMedium"
                android:textColor="?attr/colorPrimary"
                tools:text="Weightage 40%" />
        </LinearLayout>

        <TextView
            android:id="@+id/textKraTarget"
            style="@style/Widget.HRMS.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            tools:text="Target: Ship 4 modules on schedule" />

        <TextView
            android:id="@+id/textKraAchievement"
            style="@style/Widget.HRMS.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Achieved: 3 of 4 shipped" />

        <TextView
            android:id="@+id/textKraRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.HRMS.BodyMedium"
            android:textColor="?attr/colorPrimary"
            tools:text="Rating: 4.0 / 5" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
