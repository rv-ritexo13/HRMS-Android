<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.HRMS.Card.Interactive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bar_chart"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textReportMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.HRMS.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="September 2026" />

            <TextView
                android:id="@+id/textReportItemCount"
                style="@style/Widget.HRMS.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                tools:text="5 expenses" />

            <TextView
                android:id="@+id/textReportBreakdown"
                style="@style/Widget.HRMS.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="1 Submitted · 1 Approved · 1 Paid" />
        </LinearLayout>

        <TextView
            android:id="@+id/textReportTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
            android:textColor="?attr/colorPrimary"
            tools:text="₹20,150" />

        <ImageView
            android:layout_width="@dimen/icon_size_sm"
            android:layout_height="@dimen/icon_size_sm"
            android:layout_marginStart="@dimen/space_xs"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
