<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.HRMS.Card"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageBalanceIcon"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_calendar"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/textBalanceType"
            style="@style/Widget.HRMS.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Casual Leave" />

        <TextView
            android:id="@+id/textBalanceAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.HRMS.HeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="8 Days" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:trackCornerRadius="@dimen/radius_full"
            app:trackThickness="6dp"
            tools:progress="33" />

        <TextView
            android:id="@+id/textBalanceUsed"
            style="@style/Widget.HRMS.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="4 of 12 used" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
