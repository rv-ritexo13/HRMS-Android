<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.HRMS.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/payslip_cd_back"
        app:title="@string/payslip_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ===== Payslip document card ===== -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HRMS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Company header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="@dimen/avatar_size_md"
                                android:layout_height="@dimen/avatar_size_md"
                                app:cardBackgroundColor="?attr/colorPrimary"
                                app:cardCornerRadius="@dimen/radius_md"
                                app:cardElevation="@dimen/elevation_none">

                                <ImageView
                                    android:layout_width="@dimen/icon_size_md"
                                    android:layout_height="@dimen/icon_size_md"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_salary"
                                    app:tint="?attr/colorOnPrimary" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/payslip_company_name"
                                    android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    style="@style/Widget.HRMS.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/payslip_title" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_width_thin"
                            android:layout_marginVertical="@dimen/space_md"
                            android:background="?attr/colorOutline" />

                        <!-- Pay period -->
                        <TextView
                            style="@style/Widget.HRMS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payslip_pay_period" />

                        <TextView
                            android:id="@+id/textPayPeriod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="September 2026" />

                        <!-- Employee details -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Widget.HRMS.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/payslip_employee_name" />

                                <TextView
                                    android:id="@+id/textEmployeeName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.HRMS.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Rahul Verma" />

                                <TextView
                                    style="@style/Widget.HRMS.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_md"
                                    android:text="@string/payslip_department" />

                                <TextView
                                    android:id="@+id/textDepartment"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.HRMS.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Engineering" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Widget.HRMS.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/payslip_employee_id" />

                                <TextView
                                    android:id="@+id/textEmployeeId"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.HRMS.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="EMP001" />

                                <TextView
                                    style="@style/Widget.HRMS.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_md"
                                    android:text="@string/payslip_designation" />

                                <TextView
                                    android:id="@+id/textDesignation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.HRMS.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Software Engineer" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_width_thin"
                            android:layout_marginVertical="@dimen/space_lg"
                            android:background="?attr/colorOutline" />

                        <!-- Earnings -->
                        <TextView
                            style="@style/Widget.HRMS.Text.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/salary_earnings" />

                        <include
                            android:id="@+id/pRowBasic"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md" />

                        <include
                            android:id="@+id/pRowHra"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <include
                            android:id="@+id/pRowSpecial"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <include
                            android:id="@+id/pRowOtherAllowances"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_width_thin"
                            android:layout_marginVertical="@dimen/space_md"
                            android:background="?attr/colorOutline" />

                        <include
                            android:id="@+id/pRowGross"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <!-- Deductions -->
                        <TextView
                            style="@style/Widget.HRMS.Text.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:text="@string/salary_deductions" />

                        <include
                            android:id="@+id/pRowPf"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md" />

                        <include
                            android:id="@+id/pRowPtax"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <include
                            android:id="@+id/pRowOtherDeductions"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_width_thin"
                            android:layout_marginVertical="@dimen/space_md"
                            android:background="?attr/colorOutline" />

                        <include
                            android:id="@+id/pRowTotalDeductions"
                            layout="@layout/item_salary_component"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Net payable ===== -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.HRMS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    app:cardBackgroundColor="@color/hrms_status_info_container">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/payslip_net_payable"
                                android:textAppearance="@style/TextAppearance.HRMS.TitleMedium"
                                android:textColor="@color/hrms_status_info" />

                            <TextView
                                android:id="@+id/textPayDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.HRMS.BodySmall"
                                android:textColor="@color/hrms_status_info"
                                tools:text="Credited 30 September 2026" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textNetPayable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.HRMS.HeadlineMedium"
                            android:textColor="@color/hrms_status_info"
                            tools:text="₹79,000" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Actions ===== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonViewPdf"
                    style="@style/Widget.HRMS.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/payslip_action_view_pdf"
                    app:icon="@drawable/ic_picture_as_pdf" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDownload"
                        style="@style/Widget.HRMS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/payslip_action_download"
                        app:icon="@drawable/ic_download" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonShare"
                        style="@style/Widget.HRMS.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/payslip_action_share"
                        app:icon="@drawable/ic_share" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.triotech.hrms.ui.components.LoadingView
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.triotech.hrms.ui.components.ErrorView
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
